# Server port
PORT=8787
# Optional shared secret. When set, every /api request must carry header X-App-Token with this value.
APP_ACCESS_TOKEN=
# Allow browsers to supply their own provider keys per request (default true).
ALLOW_CLIENT_KEYS=true
# Server-side provider keys (optional defaults; clients can override with their own keys)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
SERPAPI_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
# Optional OpenAI image model/quality defaults (otherwise the newest GPT Image model the key can access, quality medium)
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
